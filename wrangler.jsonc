{
  "name": "anchor",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "anchor-db",
      "database_id": "187097ff-6b8b-4a69-81a6-8f4fcb4d73c6"
    }
  ]
}
